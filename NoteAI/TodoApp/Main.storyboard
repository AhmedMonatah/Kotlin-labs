                                    <rect key="frame" x="0.0" y="0.0" width="393" height="50"/>
                                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                    <subviews>
                                        <segmentedControl opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="top" segmentControlStyle="plain" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="ip-filter">
                                            <rect key="frame" x="16" y="10" width="361" height="31"/>
                                            <segments>
                                                <segment title="All"/>
                                                <segment title="Low"/>
                                                <segment title="Mid"/>
                                                <segment title="High"/>
                                            </segments>
                                            <connections>
                                                <action selector="priorityFilterChanged:" destination="inprogress-vc" eventType="valueChanged" id="ip-act-filt"/>
                                            </connections>
                                        </segmentedControl>
                                    </subviews>
                                    <constraints>
                                        <constraint firstItem="ip-filter" firstAttribute="leading" secondItem="ip-header" secondAttribute="leading" constant="16" id="ipf-l"/>
                                        <constraint firstAttribute="trailing" secondItem="ip-filter" secondAttribute="trailing" constant="16" id="ipf-r"/>
                                        <constraint firstItem="ip-filter" firstAttribute="centerY" secondItem="ip-header" secondAttribute="centerY" id="ipf-c"/>
                                    </constraints>
                                </view>
                                <prototypes>
                                    <tableViewCell clipsSubviews="YES" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" selectionStyle="none" hidesAccessoryWhenEditing="NO" indentationLevel="1" indentationWidth="0.0" reuseIdentifier="TaskCell" id="cell-inprogress" customClass="TaskCell">
                                        <rect key="frame" x="0.0" y="100" width="393" height="170"/>
                                        <autoresizingMask key="autoresizingMask"/>
                                        <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" insetsLayoutMarginsFromSafeArea="NO" tableViewCell="cell-inprogress" id="cnt-inprogress">
                                            <rect key="frame" x="0.0" y="0.0" width="393" height="170"/>
                                            <autoresizingMask key="autoresizingMask"/>
                                            <subviews>
                                                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ip-card">
                                                    <rect key="frame" x="18" y="8.5" width="357" height="153"/>
                                                    <subviews>
                                                        <label opaque="NO" userLabel="Title" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Task Title" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="1" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ip-title">
                                                            <rect key="frame" x="16" y="16" width="325" height="32"/>
                                                            <fontDescription key="fontDescription" type="boldSystem" pointSize="22"/>
                                                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Desc" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Description" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ip-desc">
                                                            <rect key="frame" x="16" y="54" width="325" height="42"/>
                                                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                                            <color key="textColor" white="1" alpha="0.85" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Date" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Date" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ip-date">
                                                            <rect key="frame" x="16" y="110" width="200" height="16"/>
                                                            <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                            <color key="textColor" white="1" alpha="0.75" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Status" contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="ip-status">
                                                            <rect key="frame" x="250" y="110" width="90" height="20"/>
                                                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="11"/>
                                                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                        </label>
                                                    </subviews>
                                                    <color key="backgroundColor" red="0.424" green="0.388" blue="1.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                    <constraints>
                                                        <constraint firstItem="ip-title" firstAttribute="leading" secondItem="ip-card" secondAttribute="leading" constant="16" id="ip-tl"/>
                                                        <constraint firstAttribute="trailing" secondItem="ip-title" secondAttribute="trailing" constant="16" id="ip-tr"/>
                                                        <constraint firstItem="ip-title" firstAttribute="top" secondItem="ip-card" secondAttribute="top" constant="16" id="ip-tt"/>
                                                        <constraint firstItem="ip-desc" firstAttribute="leading" secondItem="ip-title" secondAttribute="leading" id="ip-dl"/>
                                                        <constraint firstItem="ip-desc" firstAttribute="trailing" secondItem="ip-title" secondAttribute="trailing" id="ip-dr"/>
                                                        <constraint firstItem="ip-desc" firstAttribute="top" secondItem="ip-title" secondAttribute="bottom" constant="6" id="ip-dt"/>
                                                        <constraint firstItem="ip-date" firstAttribute="leading" secondItem="ip-title" secondAttribute="leading" id="ip-dal"/>
                                                        <constraint firstItem="ip-date" firstAttribute="bottom" secondItem="ip-card" secondAttribute="bottom" constant="-16" id="ip-dab"/>
                                                    </constraints>
                                                </view>
                                            </subviews>
                                            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                            <constraints>
                                                <constraint firstItem="ip-card" firstAttribute="width" constant="357" id="ip-cw"/>
                                                <constraint firstItem="ip-card" firstAttribute="height" constant="153" id="ip-ch"/>
                                                <constraint firstItem="ip-card" firstAttribute="centerX" secondItem="cnt-inprogress" secondAttribute="centerX" id="ip-ccx"/>
                                                <constraint firstItem="ip-card" firstAttribute="centerY" secondItem="cnt-inprogress" secondAttribute="centerY" id="ip-ccy"/>
                                            </constraints>
                                        </tableViewCellContentView>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <connections>
                                            <outlet property="cardView" destination="ip-card" id="out-ip-card"/>
                                            <outlet property="titleLabel" destination="ip-title" id="out-ip-title"/>
                                            <outlet property="detailLabel" destination="ip-desc" id="out-ip-desc"/>
                                            <outlet property="dateLabel" destination="ip-date" id="out-ip-date"/>
                                            <outlet property="statusLabel" destination="ip-status" id="out-ip-status"/>
                                        </connections>
                                    </tableViewCell>
                                </prototypes>
                                <connections>
                                    <outlet property="dataSource" destination="inprogress-vc" id="inprogress-ds"/>
                                    <outlet property="delegate" destination="inprogress-vc" id="inprogress-dl"/>
                                </connections>
                            </tableView>
                            <view hidden="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="inprogress-empty">
                                <rect key="frame" x="80" y="276" width="233" height="300"/>
                                <subviews>
                                    <imageView clipsSubviews="YES" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="hourglass" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="ip-eimg">
                                        <rect key="frame" x="41.5" y="20" width="150" height="150"/>
                                        <color key="tintColor" red="0.424" green="0.388" blue="1.0" alpha="0.5" colorSpace="custom" customColorSpace="sRGB"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="150" id="ip-eih"/>
                                            <constraint firstAttribute="width" constant="150" id="ip-eiw"/>
                                        </constraints>
                                    </imageView>
                                    <label opaque="NO" userLabel="EmptyLabel" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Nothing in progress" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ip-etxt">
                                        <rect key="frame" x="0.0" y="190" width="233" height="27"/>
                                        <fontDescription key="fontDescription" type="system" weight="medium" pointSize="22"/>
                                        <color key="textColor" red="0.424" green="0.388" blue="1.0" alpha="0.6" colorSpace="custom" customColorSpace="sRGB"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="ip-eimg" firstAttribute="centerX" secondItem="inprogress-empty" secondAttribute="centerX" id="ip-eicx"/>
                                    <constraint firstItem="ip-eimg" firstAttribute="top" secondItem="inprogress-empty" secondAttribute="top" constant="20" id="ip-eit"/>
                                    <constraint firstItem="ip-etxt" firstAttribute="top" secondItem="ip-eimg" secondAttribute="bottom" constant="20" id="ip-et"/>
                                    <constraint firstItem="ip-etxt" firstAttribute="width" secondItem="inprogress-empty" secondAttribute="width" id="ip-etw"/>
                                    <constraint firstItem="ip-etxt" firstAttribute="centerX" secondItem="inprogress-empty" secondAttribute="centerX" id="ip-etcx"/>
                                    <constraint firstAttribute="height" constant="300" id="ip-eh"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="inprogress-safe-area"/>
                        <color key="backgroundColor" red="0.949" green="0.945" blue="0.976" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="inprogress-table" firstAttribute="top" secondItem="inprogress-view" secondAttribute="top" id="ip-vbt"/>
                            <constraint firstItem="inprogress-table" firstAttribute="leading" secondItem="inprogress-view" secondAttribute="leading" id="ip-vbl"/>
                            <constraint firstItem="inprogress-table" firstAttribute="trailing" secondItem="inprogress-view" secondAttribute="trailing" id="ip-vbr"/>
                            <constraint firstItem="inprogress-table" firstAttribute="bottom" secondItem="inprogress-view" secondAttribute="bottom" id="ip-vbb"/>
                            <constraint firstItem="inprogress-empty" firstAttribute="centerX" secondItem="inprogress-view" secondAttribute="centerX" id="ip-vcx"/>
                            <constraint firstItem="inprogress-empty" firstAttribute="centerY" secondItem="inprogress-view" secondAttribute="centerY" id="ip-vcy"/>
                            <constraint firstItem="inprogress-empty" firstAttribute="leading" secondItem="inprogress-safe-area" secondAttribute="leading" constant="80" id="ip-vel"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="In Progress" id="inprogress-nav-item"/>
                    <connections>
                        <outlet property="tableView" destination="inprogress-table" id="out-inprogress-table"/>
                        <outlet property="prioritySegmentedControl" destination="ip-filter" id="out-ip-filt"/>
                        <outlet property="emptyStateView" destination="inprogress-empty" id="out-inprogress-empty"/>
                        <outlet property="statusImageView" destination="ip-eimg" id="out-ip-eimg-v2"/>
                        <outlet property="statusLabel" destination="ip-etxt" id="out-ip-etxt-v2"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="inprogress-mask" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="600" y="800"/>
        </scene>
    </scenes>
