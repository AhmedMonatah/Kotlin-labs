                            <constraint firstItem="home-table" firstAttribute="leading" secondItem="home-view" secondAttribute="leading" id="h-tbl"/>
                            <constraint firstItem="home-table" firstAttribute="trailing" secondItem="home-view" secondAttribute="trailing" id="h-tbr"/>
                            <constraint firstItem="home-table" firstAttribute="bottom" secondItem="home-view" secondAttribute="bottom" id="h-tbb"/>
                            <constraint firstItem="home-empty" firstAttribute="centerX" secondItem="home-view" secondAttribute="centerX" id="h-ecx"/>
                            <constraint firstItem="home-empty" firstAttribute="centerY" secondItem="home-view" secondAttribute="centerY" id="h-ecy"/>
                            <constraint firstItem="home-empty" firstAttribute="leading" secondItem="home-safe-area" secondAttribute="leading" constant="80" id="h-el"/>
                        </constraints>
