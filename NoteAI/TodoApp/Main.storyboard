                                        <rect key="frame" x="0.0" y="190" width="233" height="27"/>
                                        <fontDescription key="fontDescription" type="system" weight="medium" pointSize="22"/>
                                        <color key="textColor" white="0.6666666666" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="h-eimg" firstAttribute="centerX" secondItem="home-empty" secondAttribute="centerX" id="h-eicx"/>
                                    <constraint firstItem="h-eimg" firstAttribute="top" secondItem="home-empty" secondAttribute="top" constant="20" id="h-eit"/>
                                    <constraint firstItem="h-etxt" firstAttribute="top" secondItem="h-eimg" secondAttribute="bottom" constant="20" id="h-et"/>
