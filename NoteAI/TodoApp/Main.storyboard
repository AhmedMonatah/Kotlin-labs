                                    <constraint firstItem="h-etxt" firstAttribute="centerX" secondItem="home-empty" secondAttribute="centerX" id="h-etcx"/>
                                    <constraint firstAttribute="height" constant="300" id="h-eh"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="home-safe-area"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
