                                                            <color key="textColor" red="0.1" green="0.1" blue="0.1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Desc" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Description" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="h-desc">
                                                            <rect key="frame" x="16" y="54" width="325" height="42"/>
                                                            <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                            <color key="textColor" red="0.15" green="0.15" blue="0.15" alpha="0.85" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Date" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Date" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="h-date">
                                                            <rect key="frame" x="16" y="110" width="200" height="16"/>
                                                            <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                                            <color key="textColor" red="0.2" green="0.2" blue="0.2" alpha="0.7" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <nil key="highlightedColor"/>
                                                        </label>
                                                        <label opaque="NO" userLabel="Status" hidden="YES" contentMode="left" translatesAutoresizingMaskIntoConstraints="NO" id="h-status">
                                                            <rect key="frame" x="0" y="0" width="1" height="1"/>
                                                        </label>
                                                    </subviews>
                                                    <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                    <constraints>
                                                        <constraint firstItem="h-title" firstAttribute="leading" secondItem="h-card" secondAttribute="leading" constant="16" id="h-tl"/>
                                                        <constraint firstAttribute="trailing" secondItem="h-title" secondAttribute="trailing" constant="16" id="h-tr"/>
                                                        <constraint firstItem="h-title" firstAttribute="top" secondItem="h-card" secondAttribute="top" constant="16" id="h-tt"/>
                                                        <constraint firstItem="h-desc" firstAttribute="leading" secondItem="h-title" secondAttribute="leading" id="h-dl"/>
                                                        <constraint firstItem="h-desc" firstAttribute="trailing" secondItem="h-title" secondAttribute="trailing" id="h-dr"/>
                                                        <constraint firstItem="h-desc" firstAttribute="top" secondItem="h-title" secondAttribute="bottom" constant="6" id="h-dt"/>
                                                        <constraint firstItem="h-date" firstAttribute="leading" secondItem="h-title" secondAttribute="leading" id="h-dal"/>
                                                        <constraint firstItem="h-date" firstAttribute="bottom" secondItem="h-card" secondAttribute="bottom" constant="-16" id="h-dab"/>
                                                    </constraints>
                                                </view>
                                            </subviews>
                                            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                            <constraints>
                                                <constraint firstItem="h-card" firstAttribute="width" constant="357" id="h-cw"/>
                                                <constraint firstItem="h-card" firstAttribute="height" constant="153" id="h-ch"/>
                                                <constraint firstItem="h-card" firstAttribute="centerX" secondItem="cnt-home" secondAttribute="centerX" id="h-ccx"/>
                                                <constraint firstItem="h-card" firstAttribute="centerY" secondItem="cnt-home" secondAttribute="centerY" id="h-ccy"/>
                                            </constraints>
                                        </tableViewCellContentView>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <connections>
                                            <outlet property="cardView" destination="h-card" id="out-h-card"/>
                                            <outlet property="titleLabel" destination="h-title" id="out-h-title"/>
                                            <outlet property="detailLabel" destination="h-desc" id="out-h-desc"/>
                                            <outlet property="dateLabel" destination="h-date" id="out-h-date"/>
                                            <outlet property="statusLabel" destination="h-status" id="out-h-status"/>
                                        </connections>
                                    </tableViewCell>
                                </prototypes>
                                <connections>
                                    <outlet property="dataSource" destination="home-vc" id="home-ds"/>
                                    <outlet property="delegate" destination="home-vc" id="home-dl"/>
                                </connections>
                            </tableView>
                            <view hidden="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="home-empty">
                                <rect key="frame" x="80" y="276" width="233" height="300"/>
                                <subviews>
                                    <imageView clipsSubviews="YES" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="tray.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="h-eimg">
                                        <rect key="frame" x="41.666666666666657" y="21.666666666666657" width="150" height="146.33333333333334"/>
                                        <color key="tintColor" white="0.6666666666" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="150" id="h-eih"/>
                                            <constraint firstAttribute="width" constant="150" id="h-eiw"/>
